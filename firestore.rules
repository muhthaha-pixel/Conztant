rules_version = '2';

// The app signs every visitor in anonymously (see initDb in js/app.js), so this
// blocks raw API access from clients that have not loaded the app, while the
// app's own Owner/Manager/Staff login handles who may do what inside it.
//
// Paste this into: Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
